HEAL6_JWT_SECRET=replace-with-a-long-random-secret
HEAL6_JWT_TTL_SECONDS=86400
HEAL6_DB_PATH=./heal6.db
# Comma-separated Google OAuth client IDs accepted by the API.
HEAL6_GOOGLE_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com,YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com,YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
