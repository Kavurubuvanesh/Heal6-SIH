# ==========================================
# 🛑 SECURITY & ENVIRONMENT VARIABLES
# ==========================================
.env
.env.*
!.env.example
*.pem
secrets.json

# ==========================================
# 🧠 ML TRAINING & LARGE DATASETS (CRITICAL)
# ==========================================
# Blocks the massive datasets from freezing your repo
ml_training/data/task1_wound_detect/*
ml_training/data/task2_area_segment/*
ml_training/data/task2_advancement/*
ml_training/data/task3_tissue_analysis/*

# Keep the folders in the repo, but ignore their contents
!ml_training/data/task1_wound_detect/.gitkeep
!ml_training/data/task2_area_segment/.gitkeep
!ml_training/data/task2_advancement/.gitkeep
!ml_training/data/task3_tissue_analysis/.gitkeep

# Block Jupyter Notebook checkpoints & Model Weights
.ipynb_checkpoints/
*.pt
*.pth
*.h5

# ==========================================
# 🐍 PYTHON & FASTAPI (BACKEND)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.log

# ==========================================
# 💻 FRONTEND (DOCTOR WEB & MOBILE APP)
# ==========================================
node_modules/
.pnp.*
doctor_web/build/
doctor_web/dist/
doctor_web/.next/
.dart_tool/
mobile_app/build/
mobile_app/.flutter-plugins
mobile_app/.pub-cache/

# OS GENERATED FILES
.DS_Store
Thumbs.db