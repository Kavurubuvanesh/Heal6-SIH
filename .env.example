# ==============================================================================
# Heal6 Production Environment Variables Template
# Copy this file to .env or .env.production before deploying: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=heal6_admin
POSTGRES_PASSWORD=heal6_secure_clinical_pass
POSTGRES_DB=heal6_db
POSTGRES_PORT=5432

# Application Ports
BACKEND_PORT=8000
DOCTOR_PORT=5173
PATIENT_PORT=5174

# Backend Telemetry Server Configuration
UVICORN_WORKERS=2
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80
ENVIRONMENT=production

# Security & Secrets (Generate with `openssl rand -hex 32`)
SECRET_KEY=heal6_clinical_jwt_secret_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
